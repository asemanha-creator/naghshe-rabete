import { Redis } from "@upstash/redis";
import { verifyAdminToken, verifyTherapistToken } from "../../lib/auth";
import { logEvent, LOG_LEVELS } from "../../lib/logger";

const redis = Redis.fromEnv();

// داشبوردِ بالینی: تجمیعِ جلساتِ بازشده، روندِ خلق، و یادداشت‌هایِ یک مراجعِ خاص
// دسترسی: ادمینِ اصلی (همه‌ی مراجعین)، یا هر درمانگر (فقط مراجعینِ خودش)
export default async function handler(req, res) {
  try {
    if (req.method !== "GET") return res.status(405).json({ error: "method not allowed" });
    const isAdmin = await verifyAdminToken(req.query.adminToken);
    const therapistId = req.query.therapistToken ? await verifyTherapistToken(req.query.therapistToken) : null;
    if (!isAdmin && !therapistId) return res.status(403).json({ error: "دسترسی غیرمجاز" });

    const email = (req.query.email || "").toLowerCase().trim();
    if (!email) return res.status(400).json({ error: "ایمیل لازم است" });

    // اگر درمانگر (نه ادمینِ اصلی) درخواست می‌دهد، باید این مراجع واقعاً متعلق به همان درمانگر باشد
    if (!isAdmin && therapistId) {
      const ownerTherapist = await redis.get(`patient_therapist:${email}`);
      if (ownerTherapist !== therapistId) {
        await logEvent(LOG_LEVELS.WARN, "admin", "تلاشِ دسترسیِ درمانگر به مراجعِ متعلق به دیگری", { therapistId, email });
        return res.status(403).json({ error: "این مراجع به شما تعلق ندارد" });
      }
    }

    // جلساتِ بازشده
    const rawUnlocked = (await redis.get(`unlocked:${email}`)) || [];
    const unlockedSessions = typeof rawUnlocked === "string" ? JSON.parse(rawUnlocked) : rawUnlocked;

    // روندِ خلق
    const rawMood = (await redis.get(`mood_log:${email}`)) || [];
    const moodLog = typeof rawMood === "string" ? JSON.parse(rawMood) : rawMood;

    // یادداشت‌ها — جست‌وجو در همه‌ی کلیدهایِ session_note برایِ این ایمیل
    const noteKeys = await redis.keys(`session_note:${email}:*`);
    const notes = [];
    for (const k of noteKeys) {
      const raw = await redis.get(k);
      const data = typeof raw === "string" ? JSON.parse(raw) : raw;
      if (data?.note) notes.push(data);
    }
    notes.sort((a, b) => (b.savedAt || 0) - (a.savedAt || 0));

    // چک‌این‌هایِ دوره‌ای
    const rawCheckinLog = (await redis.get(`checkin_log:${email}`)) || [];
    const checkinLog = typeof rawCheckinLog === "string" ? JSON.parse(rawCheckinLog) : rawCheckinLog;
    const checkinIntervalDays = await redis.get(`checkin_interval:${email}`);

    res.status(200).json({ ok: true, email, unlockedSessions, moodLog, notes, checkinLog, checkinIntervalDays });
  } catch (e) {
    console.error(e);
    await logEvent(LOG_LEVELS.ERROR, "admin", "خطایِ سرور در patient-dashboard.js", { error: e.message });
    res.status(500).json({ error: e.message || "unknown error" });
  }
}
