import { Redis } from "@upstash/redis";

const redis = Redis.fromEnv();

// ثبتِ خلقِ قبل/بعدِ هر جلسه، به‌ازایِ هر کاربر — برایِ داشبوردِ بالینی
export default async function handler(req, res) {
  try {
    if (req.method !== "POST") return res.status(405).json({ error: "method not allowed" });
    const { userEmail, sessionKey, phase, value } = req.body;
    if (!userEmail || !sessionKey || !phase) return res.status(400).json({ error: "اطلاعاتِ ناقص" });

    const emailKey = userEmail.toLowerCase().trim();
    const key = `mood_log:${emailKey}`;
    const raw = (await redis.get(key)) || [];
    const list = typeof raw === "string" ? JSON.parse(raw) : raw;
    list.push({ sessionKey, phase, value: Number(value), ts: Date.now() });
    await redis.set(key, JSON.stringify(list));
    await redis.sadd("mood_log:users_index", emailKey);

    res.status(200).json({ ok: true });
  } catch (e) {
    console.error(e);
    res.status(500).json({ error: e.message || "unknown error" });
  }
}
