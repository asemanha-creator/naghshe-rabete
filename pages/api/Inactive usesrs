import { Redis } from "@upstash/redis";
import { logEvent, LOG_LEVELS } from "../../lib/logger";

const redis = Redis.fromEnv();
import { verifyAdminToken } from "../../lib/auth";

// فهرستِ کاربرانِ ثبت‌نامی به‌همراهِ آخرین زمانِ فعالیت — برایِ پیگیریِ دستیِ کاربرانِ غیرفعال
export default async function handler(req, res) {
  try {
    if (req.method !== "GET") return res.status(405).json({ error: "method not allowed" });
    if (!(await verifyAdminToken(req.query.adminToken))) return res.status(403).json({ error: "دسترسی غیرمجاز" });

    const emails = await redis.smembers("mood_log:users_index");
    const users = [];
    for (const email of emails) {
      const lastActive = await redis.get(`last_active:${email}`);
      const rawUnlocked = (await redis.get(`unlocked:${email}`)) || [];
      const unlocked = typeof rawUnlocked === "string" ? JSON.parse(rawUnlocked) : rawUnlocked;
      users.push({ email, lastActive: lastActive || 0, unlockedCount: unlocked.length });
    }
    users.sort((a, b) => (a.lastActive || 0) - (b.lastActive || 0)); // قدیمی‌ترین (غیرفعال‌ترین) اول

    res.status(200).json({ ok: true, users });
  } catch (e) {
    console.error(e);
    await logEvent(LOG_LEVELS.ERROR, "admin", "خطایِ سرور در inactive-users.js", { error: e.message });
    res.status(500).json({ error: e.message || "unknown error" });
  }
}
