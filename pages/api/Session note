import { Redis } from "@upstash/redis";
import { verifySession } from "../../lib/auth";
import { logEvent, LOG_LEVELS } from "../../lib/logger";
import { checkRateLimit, getClientIp } from "../../lib/rateLimit";

const redis = Redis.fromEnv();

// کلماتِ کلیدیِ هشدارِ بحرانی — برایِ تشخیصِ زودهنگام و اطلاعِ فوری به درمانگر
// (فقط تشخیص، نه مسدودکردنِ ذخیره‌سازی — کاربر هرگز متوجهِ این اسکن نمی‌شود)
// نکته: این فهرست، عبارت‌هایِ مستقیم و غیرمستقیم را پوشش می‌دهد، اما هرگز کاملِ صددرصد نیست
const RISK_KEYWORDS = [
  // مستقیم — خودکشی/مرگ
  "خودکشی", "خودم را بکشم", "خودمو بکشم", "می‌خوام بمیرم", "میخوام بمیرم", "می‌خواهم بمیرم",
  "کاش بمیرم", "کاش مرده بودم", "ای‌کاش نبودم", "کاش نبودم", "دیگه نباشم بهتره", "دیگر نباشم بهتر است",
  // غیرمستقیم — ناامیدی و بی‌ارزشی
  "دیگه نمی‌خوام زندگی کنم", "دیگر نمی‌خواهم زندگی کنم", "دیگه نمی‌تونم ادامه بدم", "دیگر نمی‌توانم ادامه دهم",
  "زندگی ارزش ندارد", "زندگی ارزشی نداره", "دیگه فایده‌ای نداره", "دیگر فایده‌ای ندارد", "همه‌چی تمومه",
  "همه‌چیز تمام است", "دیگه طاقت ندارم", "دیگر طاقت ندارم", "خسته شدم از زندگی", "خسته‌ام از همه‌چی",
  "دلم می‌خواد تموم بشه", "دلم می‌خواد همه‌چی تموم بشه", "بارِ زندگی سنگینه", "دیگه امیدی نیست", "دیگر امیدی نیست",
  "کسی جام نبود بهتر بود", "بدونِ من بهتره", "بدونِ من راحت‌ترن",
  // خودآسیبی
  "آسیب به خودم", "به خودم آسیب", "خودآزاری", "خودزنی", "خودم رو نابود", "خودمو زخمی", "خودم را زخمی",
  // خشونتِ نسبت‌به دیگران (مهم در زمینه‌ی خشم/رابطه)
  "می‌خوام بهش آسیب بزنم", "میخوام بزنمش", "می‌کشمش", "میکشمش", "بلایی سرش میارم", "بلایی سرش می‌آورم",
];
function scanForRisk(text) {
  if (!text) return false;
  const normalized = text.toLowerCase().replace(/[‌\s]+/g, " ");
  return RISK_KEYWORDS.some((kw) => normalized.includes(kw.toLowerCase()));
}

// ذخیره‌ی یادداشت‌هایِ کاربر برایِ هر تکنیک — قابلِ‌استفاده هم بدونِ ورود (ناشناس)، هم با ورود (تاییدشده با نشست)
export default async function handler(req, res) {
  try {
    const ip = getClientIp(req);
    const rl = await checkRateLimit(`session-notes:${ip}`, 60, 3600);
    if (!rl.allowed) return res.status(429).json({ error: "تعدادِ درخواست‌هایتان زیاد بوده — کمی صبر کنید" });
    if (req.method !== "POST") return res.status(405).json({ error: "method not allowed" });
    const { techniqueId, note, token } = req.body;
    if (!techniqueId) return res.status(400).json({ error: "اطلاعاتِ ناقص" });

    // اگر توکن داده شده، باید معتبر باشد؛ وگرنه ناشناس ثبت می‌شود
    let emailKey = "anonymous";
    if (token) {
      const verifiedEmail = await verifySession(token);
      if (!verifiedEmail) return res.status(401).json({ error: "نشستِ نامعتبر — لطفاً دوباره وارد شوید" });
      emailKey = verifiedEmail;
    }

    const key = `session_note:${emailKey}:${techniqueId}`;
    const riskFlag = scanForRisk(note);
    await redis.set(key, JSON.stringify({ techniqueId, note, userEmail: emailKey, savedAt: Date.now(), riskFlag }));

    if (emailKey !== "anonymous") await redis.sadd("session_notes:users_index", emailKey);

    if (riskFlag && emailKey !== "anonymous") {
      const alert = { userEmail: emailKey, techniqueId, notePreview: note.slice(0, 120), ts: Date.now() };
      const rawAlerts = (await redis.get("risk_alerts:list")) || [];
      const alerts = typeof rawAlerts === "string" ? JSON.parse(rawAlerts) : rawAlerts;
      alerts.unshift(alert);
      await redis.set("risk_alerts:list", JSON.stringify(alerts.slice(0, 200)));
      await logEvent(LOG_LEVELS.CRITICAL, "userdata", "کلمه‌ی هشدارِ بحرانی در یادداشتِ کاربر یافت شد", { email: emailKey, techniqueId });
      // ایمیلِ فوری، جدا از کانالِ CRITICAL — چون این یک وضعیتِ حساسِ بالینی است، نه فقط یک خطایِ فنی
      if (process.env.RESEND_API_KEY && process.env.ADMIN_NOTIFICATION_EMAIL) {
        fetch("https://api.resend.com/emails", {
          method: "POST",
          headers: { Authorization: `Bearer ${process.env.RESEND_API_KEY}`, "Content-Type": "application/json" },
          body: JSON.stringify({
            from: "گدار <onboarding@resend.dev>",
            to: process.env.ADMIN_NOTIFICATION_EMAIL,
            subject: "🚨 هشدارِ حساسِ بالینی — نیازِ توجهِ فوری",
            html: `<p>یک کاربر (${emailKey}) عبارتی هشداردهنده در یادداشتش نوشته.</p><p>زمینه: ${techniqueId}</p><p>متن (بخشی از آن): ${note.slice(0, 200)}</p>`,
          }),
        }).catch((e) => console.error("risk alert email failed:", e));
      }
    }

    res.status(200).json({ ok: true, riskFlag });
  } catch (e) {
    console.error(e);
    await logEvent(LOG_LEVELS.ERROR, "userdata", "خطایِ سرور در session-notes.js", { error: e.message });
    res.status(500).json({ error: e.message || "unknown error" });
  }
}
