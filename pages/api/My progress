import { Redis } from "@upstash/redis";
import { verifySession } from "../../lib/auth";

const redis = Redis.fromEnv();

// بازیابیِ پیشرفتِ خودِ کاربر — حالا با تاییدِ نشست، نه ایمیلِ خام
export default async function handler(req, res) {
  try {
    if (req.method !== "GET") return res.status(405).json({ error: "method not allowed" });
    const token = req.query.token;
    const email = await verifySession(token);
    if (!email) return res.status(401).json({ error: "نشستِ نامعتبر — لطفاً دوباره وارد شوید" });

    const rawUnlocked = (await redis.get(`unlocked:${email}`)) || [];
    const unlockedSessions = typeof rawUnlocked === "string" ? JSON.parse(rawUnlocked) : rawUnlocked;

    const rawMood = (await redis.get(`mood_log:${email}`)) || [];
    const moodLog = typeof rawMood === "string" ? JSON.parse(rawMood) : rawMood;

    const rawCheckin = (await redis.get(`checkin_log:${email}`)) || [];
    const checkinLog = typeof rawCheckin === "string" ? JSON.parse(rawCheckin) : rawCheckin;

    res.status(200).json({ ok: true, unlockedSessions, moodLog, checkinLog });
  } catch (e) {
    console.error(e);
    res.status(500).json({ error: e.message || "unknown error" });
  }
}
